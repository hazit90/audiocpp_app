{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs before every launch (see launch.json "preLaunchTask").
      //
      // Initialises the audio.cpp submodule, fetches Dart packages, and rebuilds
      // libaudiocpp_ffi.dylib when it is missing or stale. Without this, a build
      // silently succeeds without the native library and only fails at runtime.
      //
      // No-ops in well under a second when nothing has changed.
      "label": "audiocpp: setup macOS",
      "type": "shell",
      "command": "${workspaceFolder}/packages/audiocpp/tool/setup_macos.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Same, but forces a native rebuild. Use after changing build flags.
      "label": "audiocpp: rebuild native library",
      "type": "shell",
      "command": "${workspaceFolder}/packages/audiocpp/tool/setup_macos.sh",
      "options": { "env": { "FORCE": "1" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      // The Windows twin of "audiocpp: setup macOS". Same contract: submodule,
      // pub get, and a rebuild of audiocpp_ffi.dll only when it is stale.
      //
      // Needs cl.exe on PATH, so run VS Code from a Developer PowerShell (or
      // point terminal.integrated.defaultProfile.windows at one). The script
      // says so explicitly rather than failing inside CMake.
      "label": "audiocpp: setup Windows",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/packages/audiocpp/tool/setup_windows.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Same, but forces a native rebuild. Use after changing build flags.
      "label": "audiocpp: rebuild native library (Windows)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/packages/audiocpp/tool/setup_windows.ps1",
        "-Force"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
